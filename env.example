# Copie este arquivo para ".env" e preencha com seus dados reais.
# Nunca suba o arquivo ".env" (com dados reais) para o GitHub.

PORT=3000

# CEP de onde a Acid Straps envia os pacotes
CEP_ORIGEM=00000000

# Credenciais da API dos Correios (portal CWS / Meu Correios)
# CORREIOS_SENHA_API é o código de acesso à API, não a senha do site.
CORREIOS_USUARIO=
CORREIOS_SENHA_API=
CORREIOS_BASE_URL=https://api.correios.com.br
